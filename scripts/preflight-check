#!/bin/sh
# preflight-check — audit this repository against the AGENTS.md flight checklist.
#
# Usage: scripts/preflight-check [repo-root]
#
# Checks:
#   1. AGENTS.md and README.md are byte-for-byte identical (PROTOCOL.md, Art. I)
#   2. Every checklist file exists
#   3. Every skill in .github/skills/ has SKILL.md with name/description frontmatter
#
# Exits 0 if all checks pass, 1 otherwise.

set -u

ROOT="${1:-.}"
cd "$ROOT" || { echo "FAIL: cannot cd to $ROOT"; exit 1; }

fail=0
ok()   { printf '  OK   %s\n' "$1"; }
bad()  { printf '  FAIL %s\n' "$1"; fail=1; }

echo "== Preflight check =="

echo "-- Mirror --"
if [ -f AGENTS.md ] && [ -f README.md ] && cmp -s AGENTS.md README.md; then
  ok "AGENTS.md and README.md are identical"
else
  bad "AGENTS.md and README.md differ (or one is missing) — run the sync-mirrored-files skill"
fi

echo "-- Checklist files --"
for f in AGENTS.md README.md PROTOCOL.md SKILLS.md WIKI.yaml CATALOG.md \
         MEMORY.md PLUGINS.md KNOWLEDGE.md WORKFLOWS.md SUPPORT.md UTILITIES.md; do
  if [ -f "$f" ]; then
    ok "$f exists"
  else
    bad "$f is missing"
  fi
done

echo "-- Skills --"
if [ -d .github/skills ]; then
  found=0
  for dir in .github/skills/*/; do
    [ -d "$dir" ] || continue
    found=1
    name=$(basename "$dir")
    skill="$dir/SKILL.md"
    if [ ! -f "$skill" ]; then
      bad "$name: missing SKILL.md"
      continue
    fi
    if [ "$(head -n 1 "$skill")" != "---" ]; then
      bad "$name: SKILL.md missing YAML frontmatter"
      continue
    fi
    awk '
      function has_key(line, key, colon, head) {
        colon = index(line, ":")
        if (colon == 0) {
          return 0
        }
        head = substr(line, 1, colon - 1)
        sub(/^[[:space:]]*/, "", head)
        sub(/[[:space:]]*$/, "", head)
        if (head ~ /^".*"$/ || head ~ /^'\''.*'\''$/) {
          head = substr(head, 2, length(head) - 2)
        }
        return head == key
      }
      function has_value(line, value) {
        value = substr(line, index(line, ":") + 1)
        sub(/^[[:space:]]*/, "", value)
        sub(/[[:space:]]*$/, "", value)
        return value != "" && value !~ /^#/ && value != "\"\"" && value != "'\'''\''"
      }
      NR == 1 { next }
      $0 == "---" { closed=1; exit }
      has_key($0, "name") && has_value($0) { has_name=1 }
      has_key($0, "description") && has_value($0) { has_description=1 }
      END {
        if (!closed) exit 1
        if (!has_name) exit 2
        if (!has_description) exit 3
      }
    ' "$skill"
    status=$?
    if [ "$status" -ne 0 ]; then
      case "$status" in
        1) bad "$name: SKILL.md frontmatter is not closed with '---'" ;;
        2) bad "$name: frontmatter missing non-empty 'name'" ;;
        3) bad "$name: frontmatter missing non-empty 'description'" ;;
        *) bad "$name: could not validate frontmatter" ;;
      esac
      continue
    fi
    if grep -q "^| \`$name\`" SKILLS.md 2>/dev/null; then
      ok "$name: valid frontmatter, registered in SKILLS.md"
    else
      bad "$name: not registered in the 'Installed skills' table in SKILLS.md"
    fi
  done
  [ "$found" -eq 1 ] || bad ".github/skills exists but contains no skills"
else
  bad ".github/skills directory is missing"
fi

echo "== Result =="
if [ "$fail" -eq 0 ]; then
  echo "PASS: repository is flight-ready"
  exit 0
else
  echo "FAIL: fix the items above (see SUPPORT.md for troubleshooting)"
  exit 1
fi
